#!/usr/bin/env python3
"""stack-lint — one sentence that carries three ideas or more.

Tom, 7 October 2026, recutting the first paragraph of a Linux book:

  "Before the smartphone, AI and Google, I needed a way to build an
  e-commerce platform that could run web services, create simple catalogs
  and take payments."

  "I believe the ideas are stacked and make reading difficult." He split it:
  "I needed a way to build an e-commerce platform. We would need one that
  could run web services, create catalogs and take payments. Microsoft gave
  me a server without the ability to do those things." Then he named the
  form: "an old model called expository writing. Three sentences with a
  topic sentence and two modifiers."

A reader holds one idea at a time. A sentence that adds a second clause,
then an appositive, then a relative clause, makes the reader carry all of
them to the period. This program counts the ideas in each sentence and
points at the ones that carry three or more. A person splits them, because
only a person knows which idea leads.

  stack-lint FILE [FILE ...]        report
  stack-lint --min N FILE           ideas that make a stack (default 3)
  stack-lint --words N FILE         shortest sentence to check (default 15)

  A sentence of 30 words or more flags with one idea fewer.

WHAT COUNTS AS AN IDEA

  the main clause, and every clause joined to it with a verb of its own:
  a second main clause (", and", ", so", ", but"), a verb that shares the
  subject ("built those attachments, added IMAP ... and watched"), a
  relative or adverbial clause set off by a comma ("DCE, which Microsoft
  licensed"; "When Ericsson moved its mail to Exchange, ..."), and an
  appositive or participle phrase set off by commas ("DCE, an open
  standard it had licensed").

  A clause with no comma narrows a noun ("posts people made") or completes
  a verb ("found that ...", "wanted to ...") and does not count. Lists of
  nouns do not count: "payroll, accounts receivable, general ledger" names
  one thing.

The fix, the expository unit: a topic sentence and two that support it.
Keep the writer's words; change only the joints. Report only, never a
rewrite.
"""
import os
import re
import sys

VENV_SITE = os.path.expanduser("~/pipeline-venv/lib/python3.12/site-packages")
SKIP_LINE = re.compile(r"^\s*(?:#{1,6}\s|\||>|!\[|https?://|\s*[-*=]{3,}\s*$)")
INLINE_CODE = re.compile(r"`[^`]*`")


def parser():
    for extra in (None, VENV_SITE):
        if extra and os.path.isdir(extra) and extra not in sys.path:
            sys.path.insert(0, extra)
        try:
            import spacy
            return spacy.load("en_core_web_sm")
        except Exception:
            continue
    print("stack-lint: spaCy not found.", file=sys.stderr)
    sys.exit(2)


def prose_lines(text):
    fenced = False
    for n, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced or not line.strip() or SKIP_LINE.match(line):
            continue
        yield n, INLINE_CODE.sub("X", line)


def has_own_verb(tok):
    return tok.pos_ in ("VERB", "AUX")


def set_off(tok, sent):
    """A clause set off by a comma adds an idea ("DCE, which Microsoft
    licensed"). One with no comma narrows a noun ("posts people made") or
    finishes the thought, and stays part of the idea it serves."""
    left = tok.left_edge.i
    if left > sent.start and tok.doc[left - 1].text in (",", ";", ":"):
        return True
    # an opening clause: "When Ericsson moved its mail to Exchange, ..."
    right = tok.right_edge.i
    return left == sent.start and right + 1 < sent.end and tok.doc[right + 1].text == ","


def ideas(sent):
    """Return (kind, token) for each idea this sentence opens."""
    units = []
    for tok in sent:
        if tok.dep_ == "ROOT" and has_own_verb(tok):
            units.append(("main", tok))
        elif tok.dep_ == "conj" and has_own_verb(tok) and tok.head.pos_ in ("VERB", "AUX"):
            units.append(("and", tok))
        elif tok.dep_ in ("relcl", "advcl") and has_own_verb(tok) and set_off(tok, sent):
            units.append((tok.dep_, tok))
        elif tok.dep_ == "appos" and tok.i > sent.start and tok.doc[tok.left_edge.i - 1].text == ",":
            units.append(("appos", tok))
        elif tok.dep_ == "acl" and tok.tag_ in ("VBG", "VBN") and tok.i > sent.start \
                and tok.doc[tok.left_edge.i - 1].text == ",":
            units.append(("acl", tok))
    return units


def scan(path, nlp, least, shortest, long_at=30):
    text = open(path, encoding="utf-8", errors="replace").read()
    rows = []
    for n, line in prose_lines(text):
        for sent in nlp(line).sents:
            words = [t for t in sent if not t.is_punct and not t.is_space]
            if len(words) < shortest:
                continue
            units = ideas(sent)
            # a long sentence with two ideas stacks too: the reader carries
            # the first across thirty words before the second arrives.
            if len(units) >= least or (len(units) >= least - 1 and len(words) >= long_at):
                kinds = ", ".join(k for k, _ in units)
                rows.append((n, len(units), len(words), kinds, sent.text.strip()))
    return rows


def main(argv):
    least, shortest, files = 3, 15, []
    it = iter(argv)
    for a in it:
        if a == "--min":
            least = int(next(it))
        elif a == "--words":
            shortest = int(next(it))
        else:
            files.append(a)
    if not files:
        print(__doc__)
        return 1
    nlp = parser()
    for path in files:
        rows = scan(path, nlp, least, shortest)
        print(f"\n== stack-lint: {path} ==  ({len(rows)} to read)")
        for n, k, w, kinds, s in rows:
            print(f"  {n:5}: [STACK {k}] {w} words ({kinds}) — {s[:110]}…")
    print("\n  (report, never a rewrite. Split each into a topic sentence and two\n"
          "   that support it. Keep the words; change the joints.)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
