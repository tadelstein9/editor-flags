#!/usr/bin/env python3
"""rhythm-lint — a finished page read for flow, one sentence at a time.

Tom, 13 October 2026, reading the opening of Hands-On Linux Infrastructure,
Chapter 1, sentence by sentence. Each rule below comes from his ear on a
real sentence, and the sentence that taught it sits beside the rule.

  rhythm-lint FILE [FILE ...]        report
  rhythm-lint --profile FILE         each sentence's length, opening and clauses, then report
  rhythm-lint --test                 run the cases in tests/rhythm/ and say pass or fail

RULES

  WRONG-PREP   a person and a machine joined by the wrong preposition.
               "The clerk works at a Dell Inspiron 5567." A person works at
               a desk or a job and works on a computer. (Tom, 13 Oct 2026)

  NO-TOPIC     a paragraph that opens on a detail instead of its topic.
               "The rhythm needs a topic." In expository form the first
               sentence states the paragraph's idea and the next sentences
               support it (McCrimmon, Writing with a Purpose, 1963: the
               thesis is to the paper "what the topic sentence or topic idea
               is to the paragraph"). The program sees the sign of a detail:
               a first sentence carrying a figure, a model number or a date
               (three digits or more, or letters mixed with digits), in a
               paragraph of two or more sentences. List items do not count, nor
               the opening above a <!-- thesis --> mark (Bain allows a first
               paragraph "obviously preparatory"), nor text that resumes a
               paragraph after a code block. A person decides
               whether that sentence states the idea. (Tom, 13 Oct 2026)

  SOUND-ECHO   two words close together in one sentence that open on the same
               stressed sound or rhyme. "An owner can boot Linux on an older Dell
               laptop": owner and older both open on a stressed long O. The echo
               pulls the reader's attention off the subject and onto the sound.
               Read from the CMU Pronouncing Dictionary (data/cmudict). Content
               words only, within six words; the same word twice belongs to
               repeat-lint. (Tom, 15 Oct 2026)

  THESIS       the author marks the thesis with <!-- thesis --> on the line above it.
               The first sentence after the mark is tested against McCrimmon's
               tests (Writing with a Purpose, 1963, p. 40): "a single sentence,
               preferably a simple sentence," "restricted, unified, and precise."
                 THESIS-TWO      two main clauses, each with its own subject:
                                 two claims where unity asks for one
                 THESIS-COMPLEX  a clause hung on the main one (because, which,
                                 that ...): "preferably a simple sentence"
                 THESIS-VAGUE    a word open to more than one reading: things,
                                 issues, various, aspects ... A word that a colon
                                 list names at once ("two things: X and Y") passes.
               Restriction takes judgment; the report asks it as a question.
               With no mark, the report says so and tests nothing. (Tom, 15 Oct 2026)

Reads grammar with spaCy from ~/pipeline-venv. Skips fenced code, inline
code, headings, tables and block quotations. Reports. Never rewrites. A
person decides on every flag. Always exits 0.
"""
import os
import re
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
TESTS = os.path.join(os.path.dirname(HERE), "tests", "rhythm")
VENV_SITE = os.path.expanduser("~/pipeline-venv/lib/python3.12/site-packages")
_NLP = None

SKIP_LINE = re.compile(r"^\s*(?:#{1,6}\s|\||>|!\[|https?://|<!--|\s*[-*=]{3,}\s*$)")
THESIS_MARK = re.compile(r"^\s*<!--\s*thesis\s*-->\s*$", re.I)
VAGUE = {
    "thing", "things", "issue", "issues", "various", "aspect", "aspects", "stuff",
    "factor", "factors", "area", "areas", "certain", "very", "really", "interesting",
    "important", "significant", "nature", "situation", "element", "elements",
}
INLINE_CODE = re.compile(r"`[^`]*`")

# Machines a person works on, by common noun and by maker or model name.
MACHINE_NOUNS = {
    "computer", "laptop", "desktop", "pc", "server", "workstation", "machine",
    "notebook", "chromebook", "tablet", "terminal", "keyboard",
}
MACHINE_NAMES = {
    "dell", "inspiron", "optiplex", "precision", "latitude", "thinkpad", "lenovo",
    "hp", "elitebook", "probook", "macbook", "imac", "mac", "surface", "acer", "asus",
}
# verb lemma -> (wrong preposition, right preposition) when the object is a machine
PREP_WITH_MACHINE = {
    "work": ("at", "on"),
}

CMUDICT = os.path.join(os.path.dirname(HERE), "data", "cmudict")
_PRON = None
ECHO_WINDOW = 6
CONTENT = {"NOUN", "PROPN", "VERB", "ADJ", "ADV"}
# Words a reader passes over without hearing them, and names that come in sets.
ECHO_SKIP = {
    "then", "again", "also", "only", "now", "still", "even", "just", "once", "too",
    "january", "february", "march", "april", "may", "june", "july", "august",
    "september", "october", "november", "december",
}


def _pron():
    global _PRON
    if _PRON is None:
        _PRON = {}
        if os.path.exists(CMUDICT):
            for l in open(CMUDICT, encoding="latin-1"):
                p = l.split()
                if len(p) > 2 and p[1] == "1":
                    _PRON[p[0].lower()] = p[2:]
    return _PRON


def _bare(x):
    return re.sub(r"\d", "", x)


def sound_head(ph):
    """The sounds up to the first vowel, when that vowel carries the main stress."""
    out = []
    for x in ph:
        out.append(_bare(x))
        if x[-1].isdigit():
            return tuple(out) if x[-1] == "1" else None
    return None


def sound_tail(ph):
    """The rhyme: the last stressed vowel to the end."""
    idx = [i for i, x in enumerate(ph) if x.endswith("1")]
    return tuple(_bare(x) for x in ph[idx[-1]:]) if idx else None


def sound_echo(sent):
    pron = _pron()
    words = [(t, pron.get(t.lower_)) for t in sent
             if t.pos_ in CONTENT and t.is_alpha and len(t) > 2 and pron.get(t.lower_)
             # a product's or a program's name cannot change: PAM, Samba, Active Directory
             and not t.text.isupper() and t.ent_type_ not in ("PRODUCT", "ORG", "WORK_OF_ART")]
    out, seen = [], set()
    for i, (a, pa) in enumerate(words):
        for b, pb in words[i + 1:]:
            if b.i - a.i > ECHO_WINDOW:
                break
            la, lb = a.lower_, b.lower_
            # the same word, or one root in two forms (wired / wireless): repeat-lint's job
            if a.lemma_.lower() == b.lemma_.lower() or la[:4] == lb[:4] or la in ECHO_SKIP or lb in ECHO_SKIP:
                continue
            ha, hb = sound_head(pa), sound_head(pb)
            ta, tb = sound_tail(pa), sound_tail(pb)
            why = None
            if ha and ha == hb:
                why = "same opening sound"
            elif ta and ta == tb and len(ta) >= 2:
                why = "rhyme"
            if why and (a.i, b.i) not in seen:
                seen.add((a.i, b.i))
                out.append(("SOUND-ECHO", f"{a.text} / {b.text}", why + "; change one word"))
    return out


ADVICE = {
    "WRONG-PREP": "a person works on a computer, at a desk, at a job",
    "NO-TOPIC": "open the paragraph on its idea; let the details support it",
    "SOUND-ECHO": "words that echo in sound pull the eye off the subject",
    "THESIS": "one simple sentence, one claim, words with one reading",
}

DIGITS = re.compile(r"\d")
LIST_ITEM = re.compile(r"^\s*(?:\d+[.)]|[-*+])\s")


def detail(tok):
    """A figure, a model number or a date: three digits or more, or letters mixed
    with digits (i5, 7200U). A short version number ("Windows 11", "Chapter 2")
    names a thing and does not count."""
    s = tok.text
    digits = sum(c.isdigit() for c in s)
    return digits >= 3 or (digits and any(c.isalpha() for c in s))


def no_topic(sents):
    """Paragraph rule: the first sentence carries a figure, a model number or a date."""
    if len(sents) < 2:
        return []
    first = sents[0]
    shown = [t.text for t in first if detail(t)]
    if shown:
        return [("NO-TOPIC", "first sentence: " + ", ".join(shown[:3]), "state the idea first")]
    return []


PARAGRAPH_RULES = [no_topic]


def _parser():
    global _NLP
    if _NLP is not None:
        return _NLP
    if os.path.isdir(VENV_SITE) and VENV_SITE not in sys.path:
        sys.path.insert(0, VENV_SITE)
    import spacy
    _NLP = spacy.load("en_core_web_sm")
    return _NLP


def prose(text):
    """Yield (line number, cleaned line) for lines written as prose."""
    fenced = False
    for n, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced or not line.strip() or SKIP_LINE.match(line):
            continue
        yield n, INLINE_CODE.sub(lambda m: " " * len(m.group(0)), line)


def is_machine(tok):
    """A noun phrase that names a computer: its head or any compound in it."""
    words = {t.lower_ for t in tok.subtree if t.pos_ in ("NOUN", "PROPN")}
    return bool(words & MACHINE_NOUNS or words & MACHINE_NAMES)


def wrong_prep(sent):
    out = []
    for tok in sent:
        if tok.pos_ != "VERB" or tok.lemma_.lower() not in PREP_WITH_MACHINE:
            continue
        wrong, right = PREP_WITH_MACHINE[tok.lemma_.lower()]
        for prep in tok.children:
            if prep.dep_ == "prep" and prep.lower_ == wrong:
                obj = next((c for c in prep.children if c.dep_ == "pobj"), None)
                if obj is not None and is_machine(obj):
                    out.append(("WRONG-PREP", f"{tok.text} {prep.text}", f"{tok.text} {right}"))
    return out


SENTENCE_RULES = [wrong_prep, sound_echo]


def thesis_rules(sent):
    """McCrimmon's tests on the marked thesis sentence."""
    out = []
    clauses = [t for t in sent if t.dep_ == "conj" and t.pos_ in ("VERB", "AUX")
               and any(c.dep_ in ("nsubj", "nsubjpass", "expl") for c in t.children)]
    if clauses:
        out.append(("THESIS-TWO", " / ".join(t.text for t in [sent.root] + clauses),
                    "one claim; show the relation in one clause"))
    hung = [t for t in sent if t.dep_ in ("advcl", "relcl", "ccomp", "csubj")]
    if hung:
        mark = [c.text for t in hung for c in t.children if c.dep_ in ("mark",)] or [hung[0].text]
        out.append(("THESIS-COMPLEX", ", ".join(mark), "preferably a simple sentence"))
    # a vague word that a colon list names at once ("two things: X and Y") stays
    vague = [t.text for t in sent if t.lower_ in VAGUE
             and not (t.i + 1 < len(t.doc) and t.doc[t.i + 1].text == ":")]
    if vague:
        out.append(("THESIS-VAGUE", ", ".join(vague), "a word with one reading"))
    return out


def find_thesis(text):
    """The first prose line after a <!-- thesis --> mark: (line number, line) or None."""
    marked = False
    lines = dict(prose(text))
    for n, line in enumerate(text.split("\n"), 1):
        if THESIS_MARK.match(line):
            marked = True
            continue
        if marked and n in lines:
            return n, lines[n]
    return None


def sentences(text):
    """Yield (line, sentence) for each sentence on the prose lines."""
    nlp = _parser()
    for n, line in prose(text):
        for sent in nlp(line).sents:
            if sent.text.strip():
                yield n, sent


def profile(sent):
    words = [t for t in sent if t.is_alpha or t.like_num]
    root = sent.root
    subj = next((c for c in root.children if c.dep_ in ("nsubj", "nsubjpass")), None)
    before = (root.i - sent.start) if root else 0
    clauses = 1 + sum(1 for t in sent if t.dep_ in ("conj",) and t.pos_ in ("VERB", "AUX")
                      and t.head.i == root.i)
    hung = sum(1 for t in sent if t.dep_ in ("relcl", "acl", "advcl", "ccomp"))
    names = sum(1 for e in sent.ents if e.label_ in ("ORG", "PRODUCT", "GPE", "PERSON", "FAC", "LAW"))
    opener = " ".join(t.text for t in subj.subtree) if subj is not None else sent[0].text
    return (f"{len(words)} words · opens on “{opener}” ({before} words before the verb) · "
            f"{clauses} main clause{'s' if clauses > 1 else ''}, {hung} hung on · {names} names")


def continued(text):
    """Line numbers of prose that resumes a paragraph after a code block."""
    lines = text.split("\n")
    out, prev = set(), ""
    for n, line in enumerate(lines, 1):
        if line.strip():
            if prev.lstrip().startswith("```") and not line.lstrip().startswith("```"):
                out.add(n)
            prev = line
    return out


def scan(text):
    rows = []
    nlp = _parser()
    found = find_thesis(text)
    # Bain's allowance: an opening "obviously preparatory" before the thesis
    start = found[0] if found else 0
    after_code = continued(text)
    for n, line in prose(text):
        sents = [s for s in nlp(line).sents if s.text.strip()]
        skip = LIST_ITEM.match(line) or n < start or n in after_code
        for rule in ([] if skip else PARAGRAPH_RULES):
            for code, span, fix in rule(sents):
                rows.append((n, code, span, fix, sents[0].text.strip()))
        for sent in sents:
            for rule in SENTENCE_RULES:
                for code, span, fix in rule(sent):
                    rows.append((n, code, span, fix, sent.text.strip()))
    if found:
        n, line = found
        sent = next(s for s in nlp(line).sents if s.text.strip())
        for code, span, fix in thesis_rules(sent):
            rows.append((n, code, span, fix, sent.text.strip()))
    return rows


def run_tests():
    """Each case: NAME.md beside NAME.expect, one 'CODE|span' per expected flag."""
    if not os.path.isdir(TESTS):
        print(f"rhythm-lint: no tests in {TESTS}")
        return 1
    failed = 0
    for name in sorted(f for f in os.listdir(TESTS) if f.endswith(".md")):
        base = os.path.join(TESTS, name[:-3])
        got = {f"{c}|{s}" for _, c, s, _, _ in scan(open(base + ".md").read())}
        want = {l.strip() for l in open(base + ".expect") if l.strip() and not l.startswith("#")}
        if got == want:
            print(f"  pass  {name}  ({len(want)} flags)")
        else:
            failed += 1
            print(f"  FAIL  {name}")
            for x in sorted(want - got):
                print(f"        missed  {x}")
            for x in sorted(got - want):
                print(f"        extra   {x}")
    return 1 if failed else 0


def main(args):
    if "--test" in args:
        return run_tests()
    show = "--profile" in args
    args = [a for a in args if a != "--profile"]
    if not args:
        print(__doc__.strip())
        return 0
    for path in args:
        text = open(path).read()
        if show:
            print(f"\n== rhythm-lint profile: {path} ==")
            for n, sent in sentences(text):
                print(f"    {n:>4}: {profile(sent)}\n          {sent.text.strip()}")
        rows = scan(text)
        found = find_thesis(text)
        if found:
            th = next(s for s in _parser()(found[1]).sents if s.text.strip()).text.strip()
            print(f"\n  thesis, line {found[0]}: {th}")
            print("  restricted? can this piece, at this length, deliver it? (a person answers)")
        else:
            print(f"\n  no <!-- thesis --> mark in {path}; thesis not tested")
        if rows:
            print(f"\n== rhythm-lint: {path} ==  ({len(rows)} to read)")
            for n, code, span, fix, ctx in rows:
                snip = ctx if len(ctx) < 96 else ctx[:93] + "…"
                print(f"    {n:>4}: [{code}] “{span}” → “{fix}” — {snip}")
        else:
            print(f"rhythm-lint: no rhythm flags in {path}")
    print("\n  (report, never a rewrite. A person decides.)")
    for k, v in ADVICE.items():
        print(f"   {k:<11} {v}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
